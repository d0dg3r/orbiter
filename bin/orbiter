#!/usr/bin/env python3
"""
Orbiter Unified Command Line Interface & Runner
"""
import sys
import os
import socket
import json
import subprocess
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from orbiter.config import IPC_SOCKET

def send_ipc(command):
    if not IPC_SOCKET.exists():
        print("Fehler: Orbiter-Dienst läuft nicht.")
        return None
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(1.0)
        client.connect(str(IPC_SOCKET))
        client.sendall((command + "\n").encode("utf-8"))
        resp = client.recv(1024).decode("utf-8").strip()
        client.close()
        return resp
    except Exception as e:
        print(f"Fehler bei IPC-Verbindung: {e}")
        return None

def cmd_gui():
    from orbiter.gui.app import main as gui_main
    gui_main()

def cmd_daemon():
    from orbiter.daemon import main as daemon_main
    daemon_main()

def cmd_status():
    resp = send_ipc("GET_STATUS")
    if resp:
        try:
            st = json.loads(resp)
            print("=== Orbiter Status ===")
            print(f"Gerät verbunden:   {'Ja' if st.get('connected') else 'Nein'}")
            print(f"Gerätename:        {st.get('device_name')}")
            print(f"Aktives Profil:    {st.get('active_profile', 'Standard')}")
            print(f"Profile:           {', '.join(st.get('profiles', []))}")
            print(f"2D-Präzisionsmodus:{'AKTIV' if st.get('mode_2d') else 'HYBRID'}")
            print(f"Geschwindigkeit:   {st.get('base_speed'):.4f}")
            print(f"Deadzone:          {st.get('deadzone')}")
        except Exception:
            print(resp)

def cmd_profile():
    if len(sys.argv) > 2:
        arg = " ".join(sys.argv[2:]).strip()
        if arg.lower() == "next":
            resp = send_ipc("NEXT_PROFILE")
            if resp == "OK":
                print("Nächstes Profil aktiviert.")
        elif arg.lower() == "prev":
            resp = send_ipc("PREV_PROFILE")
            if resp == "OK":
                print("Vorheriges Profil aktiviert.")
        else:
            resp = send_ipc(f"SWITCH_PROFILE {arg}")
            if resp == "OK":
                print(f"Profil gewechselt zu: {arg}")
    else:
        resp = send_ipc("GET_STATUS")
        if resp:
            try:
                st = json.loads(resp)
                active = st.get("active_profile", "Standard")
                profs = st.get("profiles", [])
                print("=== Orbiter Profile ===")
                for p in profs:
                    prefix = "* " if p == active else "  "
                    suffix = " (aktiv)" if p == active else ""
                    print(f"{prefix}{p}{suffix}")
            except Exception:
                print(resp)

def cmd_toggle_2d():
    resp = send_ipc("TOGGLE_2D")
    if resp == "OK":
        print("2D-Modus umgeschaltet.")

def cmd_reload():
    resp = send_ipc("RELOAD")
    if resp == "OK":
        print("Konfiguration neu geladen.")

def cmd_restart():
    subprocess.run(["systemctl", "--user", "restart", "orbiter"], check=False)
    print("Dienst neu gestartet.")

def print_help():
    print("""Orbiter — 3Dconnexion Controller & Linux Driver

Verwendung:
  orbiter            Startet die grafische Benutzeroberfläche (GUI) mit Tray-Icon
  orbiter --tray     Startet direkt minimiert in die Symbolleiste (Tray)
  orbiter daemon     Startet den Hintergrund-Treiber im Terminal
  orbiter status     Zeigt den Status des laufenden Dienstes an
  orbiter profile    Zeigt alle Profile und das aktive Profil an
  orbiter profile <name|next|prev>  Wechselt das aktive Profil
  orbiter 2d         Schaltet den 2D-Modus um
  orbiter reload     Lädt die Konfiguration neu
  orbiter restart    Startet den systemd-Dienst neu
  orbiter help       Zeigt diese Hilfe an
""")

def main():
    if len(sys.argv) < 2:
        cmd_gui()
        return

    sub = sys.argv[1].lower()
    if sub in ("gui", "ui", "settings", "--tray", "--minimized"):
        cmd_gui()
    elif sub in ("daemon", "server"):
        cmd_daemon()
    elif sub in ("status", "info"):
        cmd_status()
    elif sub in ("profile", "profiles"):
        cmd_profile()
    elif sub in ("2d", "toggle"):
        cmd_toggle_2d()
    elif sub in ("reload",):
        cmd_reload()
    elif sub in ("restart",):
        cmd_restart()
    elif sub in ("-h", "--help", "help"):
        print_help()
    else:
        print(f"Unbekannter Befehl: {sub}")
        print_help()

if __name__ == "__main__":
    main()
